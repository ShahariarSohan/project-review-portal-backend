generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------
enum UserRole {
  ADMIN
  MENTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------
// MODELS
// ---------------------------------------------------------
model User {
  id           String     @id @default(uuid())
  authId       String?
  name         String
  email        String     @unique
  password     String
  phone        String?
  profileImage String?
  coverImage   String?
  bio          String?
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isVerified   Boolean    @default(true)
  isDeleted    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projectsSubmitted Project[] @relation("StudentProjects")
  projectsReviewed  Project[] @relation("ReviewedProjects")

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  title       String
  repoUrl     String
  liveUrl     String?
  description String        @db.Text
  status      ProjectStatus @default(PENDING)
  reviewNotes String?       @db.Text

  studentId   String
  student     User          @relation("StudentProjects", fields: [studentId], references: [id], onDelete: Cascade)

  reviewerId  String?
  reviewer    User?         @relation("ReviewedProjects", fields: [reviewerId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}